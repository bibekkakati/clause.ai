{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022"],
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "composite": true,
        "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
    },
    "references": [
        { "path": "../../packages/constants" }
    ],
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
