{
    "name": "@clause-ai/api",
    "version": "1.0.0",
    "description": "Clause AI Backend API Service",
    "type": "module",
    "main": "dist/index.js",
    "imports": {
        "#*": [
            "./dist/*.js",
            "./dist/*/index.js",
            "./dist/*"
        ]
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc --build",
        "start": "tsx dist/index.js",
        "test": "vitest run",
        "generate-schema": "drizzle-kit generate",
        "migrate-schema": "drizzle-kit migrate"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1104.0",
        "@aws-sdk/s3-request-presigner": "^3.1104.0",
        "@clause-ai/constants": "*",
        "@google/genai": "^2.16.0",
        "@llamaindex/liteparse": "^2.11.1",
        "@mastra/core": "^1.57.0",
        "bullmq": "^6.0.8",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^1.0.0-rc.4",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.0.0",
        "@types/pg": "^8.20.4",
        "@types/pino-http": "^5.8.4",
        "rate-limit-redis": "^6.0.1",
        "typescript": "^5.0.0",
        "uuid": "^14.0.1",
        "zod": "^4.4.3",
        "tsx": "^4.23.5"
    },
    "devDependencies": {
        "@types/supertest": "^7.2.1",
        "drizzle-kit": "^1.0.0-rc.4",
        "pino-pretty": "^13.1.3",
        "supertest": "^7.2.2",
        "vitest": "^4.1.10"
    }
}
